# .env
# Environment definitions for the addressingserver module
# listen to all available interfaces - Might wanna change this once we use docker compose
AS_ROLE=PRIMARY
HOST_ADDRESS=0.0.0.0
# TODO - Change to dynamic port allocation and use with Docker YML for the 559Project - Fault tolerance
AS_CLIENT_PORT=49800
AS_REPLICA_PORT=49801
AS_CHATSERVER_PORT=49802

# We use environment variables to inform Addressing Server processes of their role - REPLICA or PRIMARY
# Custom gradle build tasks exist for building containers with different environment variables
# Currently, these include different ports (to run multiple containers on one machine) and a different role.
